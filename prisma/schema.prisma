// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Road {
  id           String   @id @default(uuid())
  name         String
  municipality String
  markets      Market[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("roads")
}

model Market {
  id                 String   @id @default(uuid())
  roadId             String   @map("road_id")
  weekday            Int
  startTime          String   @map("start_time")
  endTime            String   @map("end_time")
  bufferBeforeHours  Int      @map("buffer_before_hours")
  bufferAfterHours   Int      @map("buffer_after_hours")
  exceptions         Json?
  road               Road     @relation(fields: [roadId], references: [id])
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("markets")
}

model EzparkData {
  id              BigInt   @id @map("id")            // int8
  area_name       String?  @map("area_name")
  municipality    String?  @map("municipality")
  road_name       String?  @map("road_name")
  weekday_iso     Int?     @map("weekday_iso") @db.SmallInt
  season_start    String?  @map("season_start")
  season_end      String?  @map("season_end")
  permanent       Boolean? @map("permanent")
  source_day_label String? @map("source_day_label")
  latitude        Float?   @map("latitude")  @db.DoublePrecision
  longitude       Float?   @map("longitude") @db.DoublePrecision

  @@map("ezpark_data")
}